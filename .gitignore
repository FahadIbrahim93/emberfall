data/
node_modules/
test-results/
playwright-report/
coverage/
dist/
dist-portal/
dist-portal.zip
.freebuff/*.log
.freebuff/*.log.err
*.tsbuildinfo
.freebuff/scratch/
.env
*.mirror.sql

# db-backup snapshots are the user table — never commit a ledger
backups/

# fun-audit artifacts (regenerated every run) — EXCEPT the committed
# fun-curve snapshot (docs/audit/ is a dir, so ignore its CONTENTS to let
# one negation through)
docs/audit/*
!docs/audit/fun-curve.json

# battery scratch decks — ledgers never ship, again
.freebuff/scratch-*/
# the local production deck's data dir — same rule (and its backups)
.freebuff/deck-live/
.freebuff/deck-live.bak-*/

# Per-worktree agent journal: keep local, not in the product repository.
.freebuff/run.md
